[Unit]
Description=Shahdara read-only PPPoE usage collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pppoe-collector
Group=pppoe-collector
EnvironmentFile=/etc/shahdara-pppoe-collector.env
ExecStart=/usr/bin/python3 /opt/shahdara-pppoe-collector/pppoe_collector.py
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/shahdara-pppoe-collector
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
