# Copy to .env.router.local on the local laptop only. Never commit that file.
# Router credentials stay on this computer. API-SSL (8729) is the secure default.
ROUTER_HOST=192.168.88.1
ROUTER_PORT=8729
ROUTER_USER=pppoe-readonly
ROUTER_PASSWORD=REPLACE_WITH_LOCAL_ROUTER_PASSWORD
ROUTER_TIMEOUT_MS=8000
# For legacy plaintext API port 8728 only, explicitly set true and use a private-LAN address.
ROUTER_ALLOW_INSECURE_LOCAL=false

# Needed for subscriber import (--apply) and npm run live:bridge.
# Use only the approved project's publishable/anon key and an owner/admin user JWT.
SUPABASE_URL=https://YOUR_APPROVED_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY
SUPABASE_ORGANIZATION_ID=YOUR_EXISTING_ORGANIZATION_UUID
SUPABASE_ADMIN_ACCESS_TOKEN=YOUR_SIGNED_IN_OWNER_OR_ADMIN_USER_JWT
