# Browser project settings. Only VITE_* values may be embedded in the site.
# Set these only to an approved non-production project and its publishable/anon key.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY
# Hosted preview must stay synthetic; Pages also pins this flag in its workflow.
VITE_ROUTER_DRIVER=mock
# Optional separate API origin for split frontend/backend hosting. Leave blank for same-origin.
VITE_PPPOE_API_BASE_URL=

# Server-only RouterOS telemetry. Keep mock selected for development.
# For live use, create a dedicated read-only RouterOS API account.
ROUTER_DRIVER=mock
ROUTER_HOST=
ROUTER_PORT=8728
ROUTER_USER=
ROUTER_PASSWORD=
ROUTER_TIMEOUT_MS=5000
MOCK_ROUTER_HOST=10.10.20.1

# Node server options; set CORS_ORIGIN to the exact frontend origin only for split hosting.
PORT=4173
HOST=0.0.0.0
CORS_ORIGIN=

# Dedicated per-agent bearer secret; configure the same random value in the
# Supabase Edge Function server environment and the Mini PC's root-owned env file.
# Never substitute the Supabase service-role key.
SYNC_AGENT_INGEST_TOKEN=
# Keep blank until the migration is applied and the RouterOS session-delta source
# is explicitly approved. Delta totals are poller estimates, not billing-grade.
SYNC_AGENT_DELTA_SOURCE_CONFIRMED=
# Legacy gate for separately verified subscriber-cumulative sources only.
SYNC_AGENT_COUNTER_SOURCE_CONFIRMED=

# Local Mini PC agent only; store outside the repository in a root-owned environment file.
# ROUTEROS_BASE_URL must use HTTPS with a valid, verified router certificate.
ROUTEROS_BASE_URL=
ROUTEROS_USERNAME=
ROUTEROS_PASSWORD=
SYNC_INGEST_URL=
# Optional additional trust bundle path; never disable certificate verification.
NODE_EXTRA_CA_CERTS=
POLL_INTERVAL_MS=60000
REQUEST_TIMEOUT_MS=10000
MAX_RETRIES=3
MAX_BACKOFF_MS=30000
